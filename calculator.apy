# آلة حاسبة بسيطة

الرقم_الأول = 20
الرقم_الثاني = 5

جمع = الرقم_الأول + الرقم_الثاني
الطرح = الرقم_الأول - الرقم_الثاني
الضرب = الرقم_الأول * الرقم_الثاني
القسمة = الرقم_الأول / الرقم_الثاني

اطبع("جمع:")
اطبع(جمع)
اطبع("الطرح:")
اطبع(الطرح)
اطبع("الضرب:")
اطبع(الضرب)
اطبع("القسمة:")
اطبع(القسمة)
